OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free
LLM_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Optional custom-provider key override: LLM_API_KEY=
# Multilingual model for English, Hindi and Marathi; avoid English-only .en models.
WHISPER_MODEL=small
# auto uses CUDA when available, otherwise CPU int8. Set cpu if CUDA libraries are missing.
WHISPER_DEVICE=auto
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MAX_UPLOAD_MB=1024
# ARC_DATA_DIR=../data
